<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.olimpus.interagents</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/moralesvillalobos-mac/olimpussoft/olimpus-interagents/skills/interagents/bin/interagents.py</string>
    <string>connect</string>
    <string>--name</string>
    <string>interagents-supervisor</string>
    <string>--label</string>
    <string>supervisor</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/moralesvillalobos-mac/olimpussoft/olimpus-interagents</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Foreground listener: launchd restarts it if it exits. Its registry
       entry keeps the bus server from idle-shutting down, and its reconnect
       loop re-spawns the server if that process dies. -->
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/moralesvillalobos-mac/.olimpus/interagents/supervisor.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/moralesvillalobos-mac/.olimpus/interagents/supervisor.launchd.err.log</string>
</dict>
</plist>
